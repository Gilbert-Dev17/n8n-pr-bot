# Docker Compose Environment Variables
N8N_HOST=n8n-pr-bot.duckdns.org
N8N_PORT=5678
N8N_PROTOCOL=https
NODE_ENV=production
WEBHOOK_URL=https://n8n-pr-bot.duckdns.org/
GENERIC_TIMEZONE=UTC

# Node Credentials (Required in n8n UI when importing the workflow)
# - GitHub Personal Access Token (Classic with repo scope)
# - Google Gemini API Key
# - Google Cloud OAuth2 Client ID & Secret (for Gmail node)

GITHUB_ACCESS_TOKEN=your_github_pat_here
GEMINI_API_KEY=your_gemini_api_key_here
GMAIL_OAUTH_CLIENT_ID=your_google_cloud_client_id_here
GMAIL_OAUTH_CLIENT_SECRET=your_google_cloud_client_secret_here
